# Autotask API credentials (required)
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=
# AUTOTASK_API_URL=            # optional; auto-detected by zone if unset

# --- Transport (HTTP deployments) ---
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080

# --- Impersonation & caller-container attribution (see docs/DEPLOYMENT.md) ---
# Accepted values are EXACT — do not assume on/1/yes works for every flag.
# AUTOTASK_IMPERSONATION_MODE=off        # exact: off | caller. Default off. Remove/off to disable.
# AUTOTASK_IMPERSONATION_SOURCES=        # caller mode only: comma allowlist of chatgpt,hermes-teams,telegram,n8n,cron. Empty = all allowed.
# MCP_INSTANCE_LABEL=                     # any non-empty string, e.g. gpt-teams / n8n-cron. Empty = not logged.

# --- Other feature flags (each defaults OFF when unset) ---
# LAZY_LOADING=true                       # exact: true or 1 ONLY (not on/yes)
# MCP_PERMISSIONS_ENABLED=true            # exact: true ONLY. Needs AUTOTASK_ROLE_MAP.
# MCP_PG_ENABLED=true                     # exact: true ONLY. Master switch; MCP_PG_* flags inert unless on.
# MCP_PG_AUDIT_ENABLED=true               # exact: true ONLY (and MCP_PG_ENABLED=true)
